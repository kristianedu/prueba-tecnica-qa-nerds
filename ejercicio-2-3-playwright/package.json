{
  "name": "nerds-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Ejercicios 2 (API) y 3 (Chatbot web) — suite compartida de Playwright",
  "scripts": {
    "test": "playwright test",
    "test:api": "PW_TAG=api playwright test --project=api",
    "test:ui": "PW_TAG=ui playwright test --project=ui",
    "report:api": "playwright show-report ../output/playwright-report-api",
    "report:ui": "playwright show-report ../output/playwright-report-ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0",
    "zod": "^3.24.1"
  }
}
