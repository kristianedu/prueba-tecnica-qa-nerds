# ---------------------------------------------------------------
# Ejercicio 1 — Evaluación conversacional
# ---------------------------------------------------------------
# Proveedor del LLM: anthropic | groq | openai | mock
# "mock" corre sin credenciales, con conversaciones pregrabadas.
LLM_PROVIDER=mock

# Modelo que hace de ASISTENTE (el sujeto bajo prueba)
LLM_MODEL=claude-haiku-4-5

# Modelo que hace de JUEZ (el evaluador). Conviene uno con más criterio.
JUDGE_MODEL=claude-sonnet-5

# Credencial según el proveedor elegido (solo se necesita una)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------
# Ejercicio 2 — Goal Tracker API
# ---------------------------------------------------------------
API_BASE_URL=https://goal-tracker-api.onrender.com

# ---------------------------------------------------------------
# Ejercicio 3 — Chatbot web
# ---------------------------------------------------------------
CHATBOT_URL=https://botpress.com/docs
