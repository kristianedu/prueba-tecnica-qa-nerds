# ---------------------------------------------------------------
# Ejercicio 1 — Evaluación conversacional
# ---------------------------------------------------------------
# Proveedor del LLM: groq | anthropic | openai | mock
# "mock" corre sin credenciales, con conversaciones pregrabadas: es el valor por
# defecto para que el repositorio se pueda clonar y ejecutar sin nada más.
LLM_PROVIDER=mock

# Modelo que hace de ASISTENTE (el sujeto bajo prueba).
# Los catálogos cambian seguido; confirma el ID vigente con:
#   python src/runner.py --listar-modelos --proveedor groq
LLM_MODEL=openai/gpt-oss-20b

# Modelo que hace de JUEZ. Conviene el de más criterio que tengas disponible:
# es una sola llamada por turno y es quien decide la coherencia.
JUDGE_MODEL=openai/gpt-oss-120b

# Credencial según el proveedor elegido (solo se necesita una).
# Groq tiene un tier gratuito suficiente para esta prueba: https://console.groq.com

ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------
# Ejercicio 2 — Goal Tracker API
# ---------------------------------------------------------------
API_BASE_URL=https://goal-tracker-api.onrender.com

# ---------------------------------------------------------------
# Ejercicio 3 — Chatbot web
# ---------------------------------------------------------------
CHATBOT_URL=https://botpress.com/docs
